# ---------------------------------------------------------------------------
# AffiliRank — environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# ---- Supabase (optional for local demo; required for production) ----------
# Project URL + keys from https://supabase.com/dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin auth ------------------------------------------------------------
# The password you type at /admin/login (use a long, strong value).
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Any long random string used to sign the admin session cookie.
ADMIN_SECRET=change-me-to-a-long-random-secret

# ---- JVZoo affiliate tracking ----------------------------------------------
# Your JVZoo affiliate id. It is automatically appended to scraped product
# URLs when the pasted URL does not already contain it. E.g. for
# https://jvz7.com/c/3582897/416134/ the affiliate id is 3582897.
NEXT_PUBLIC_JVZOO_AFFILIATE_ID=3582897

# ---- Analytics (Google Analytics 4 + Meta Pixel) --------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ---- Public site URL (used for canonical / OG URLs) ------------------------
NEXT_PUBLIC_SITE_URL=https://affilirank.com

# ---- Licensing / VSL (optional) --------------------------------------------
# Checkout URLs for each unlockable module and the bundle. Shown on the
# /affilirank sales page. Leave empty to hide them.
UPSELL_URL_BLOG=
UPSELL_URL_UNLIMITED=
UPSELL_URL_EXIT=
UPSELL_URL_ANALYTICS=
UPSELL_URL_DEALS=
UPSELL_URL_VIDEO=
UPSELL_URL_BUNDLE=

# Embed your video sales letter (YouTube / Vimeo share URL or direct MP4).
NEXT_PUBLIC_VSL_EMBED_URL=
